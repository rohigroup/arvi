{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/click.js": {
      "maxDuration": 5
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "diagnostico.arvi.rohigroup.co"
        }
      ],
      "destination": "/diagnostico",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "diagnostico.arvi.rohigroup.co"
        }
      ],
      "destination": "/diagnostico.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "diagnostico.arvi.rohigroup.co"
        }
      ],
      "destination": "/diagnostico.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "agente.arvi.rohigroup.co"
        }
      ],
      "destination": "/agente.html"
    },
    {
      "source": "/chatbot-whatsapp-ia",
      "destination": "/chatbot-whatsapp-ia.html"
    },
    {
      "source": "/agentes-ia",
      "destination": "/agentes-ia.html"
    },
    {
      "source": "/automatizacion-procesos",
      "destination": "/automatizacion-procesos.html"
    },
    {
      "source": "/agente",
      "destination": "/agente.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://app.rohigroup.co; connect-src 'self' https://app.rohigroup.co; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
